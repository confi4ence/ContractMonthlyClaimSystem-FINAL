@{
    ViewData["Title"] = "Contract Monthly Claim System";
}

<div class="text-center py-5">
    <h1 class="display-3 fw-bold text-primary">Contract Monthly Claim System</h1>
    <p class="lead text-muted mt-3">Professional • Secure • Automated Claim Processing</p>

    @if (!User.Identity!.IsAuthenticated)
    {
        <div class="mt-5">
            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary btn-lg px-5">
                <i class="fas fa-sign-in-alt"></i> Login to Continue
            </a>
        </div>
    }
    else
    {
        <div class="row mt-5">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-lg">
                    <div class="card-body text-center">
                        <i class="fas fa-file-invoice-dollar fa-4x text-primary mb-3"></i>
                        <h5>Submit Claims</h5>
                        <p>Easy monthly claim submission with auto-calculation</p>
                        <a href="/Lecturer/Create" class="btn btn-outline-primary">Submit Now</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-lg">
                    <div class="card-body text-center">
                        <i class="fas fa-tasks fa-4x text-success mb-3"></i>
                        <h5>Track Status</h5>
                        <p>Real-time approval workflow tracking</p>
                        <a href="/Lecturer" class="btn btn-outline-success">My Claims</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-lg">
                    <div class="card-body text-center">
                        <i class="fas fa-file-pdf fa-4x text-danger mb-3"></i>
                        <h5>Reports</h5>
                        <p>HR generates professional payment reports</p>
                        @if (User.IsInRole("HR"))
                        {
                            <a href="/HR/Reports" class="btn btn-outline-danger">Generate Report</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>